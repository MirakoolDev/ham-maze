                    _a(b, _key(key));
                    if (h == 0) _a(b, '" y="0" stroke="');
                    else _a(b, string.concat('" y="-', _u(h), '" stroke="'));
                    _col(b, o2 * 34 + (bk == 0 ? 0 : bk == 1 ? 17 : 28) + h, lost ? 2 : 1);
                    _a(b, '"/>');
                }
            }
        }
    }

    function _key(uint256 key) internal pure returns (string memory) {
        bytes memory s = new bytes(3);
        s[0] = bytes1(uint8(48 + key / 9));
        s[1] = bytes1(uint8(48 + (key / 3) % 3));
        s[2] = bytes1(uint8(48 + key % 3));
        return string(s);
    }

    // ── fixed pieces ────────────────────────────────────────────────────────────
    // The figure and the floor marks differ only by where the figure stands and found/lost colours.
    function _marks(uint256 k) internal pure returns (string memory) {
        return string.concat("<path transform=\"translate(300 316) scale(1 0.5774) rotate(45) translate(-156 -156)\" d=\"M13 299L", _at(k, true), _pick(k == 6, "\" fill=\"none\" stroke=\"#ff8a3d\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-dasharray=\"0.1 7\" opacity=\"0.75\"/><circle transform=\"translate(300 316) scale(1 0.5774) rotate(45) translate(-156 -156)\" cx=\"13\" cy=\"299\" r=\"7.8\" fill=\"none\" stroke=\"#ff5f9e\" stroke-width=\"2.2\" opacity=\"0.9\"/><circle transform=\"translate(300 316) scale(1 0.5774) rotate(45) translate(-156 -156)\" cx=\"13\" cy=\"299\" r=\"2.34\" fill=\"#ff5f9e\"/>", "\" fill=\"none\" stroke=\"#e9f6ff\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-dasharray=\"0.1 7\" opacity=\"0.75\"/><circle transform=\"translate(300 316) scale(1 0.5774) rotate(45) translate(-156 -156)\" cx=\"13\" cy=\"299\" r=\"7.8\" fill=\"none\" stroke=\"#e9f6ff\" stroke-width=\"2.2\" opacity=\"0.9\"/><circle transform=\"translate(300 316) scale(1 0.5774) rotate(45) translate(-156 -156)\" cx=\"13\" cy=\"299\" r=\"2.34\" fill=\"#e9f6ff\"/>"));
    }

